{
  "name": "monoleaf-web",
  "private": true,
  "version": "1.3.3",
  "description": "Monoleaf, in the browser. A portable, single-file markdown editor with no install and no server.",
  "license": "MIT",
  "author": "vibingbiochemist <info@monoleaf.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibingbiochemist/Monoleaf_web.git"
  },
  "bugs": {
    "url": "https://github.com/vibingbiochemist/Monoleaf_web/issues"
  },
  "homepage": "https://monoleaf.org",
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "markdown-editor",
    "browser",
    "portable"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses": "node scripts/generate-licenses.mjs",
    "postinstall": "patch-package"
  },
  "overrides": {
    "katex": "$katex"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "pagedjs": "^0.4.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.1.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
