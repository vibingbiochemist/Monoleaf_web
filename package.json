{
  "name": "monoleaf-web",
  "private": true,
  "version": "1.0.0",
  "description": "Monoleaf, in the browser. A portable, single-file markdown editor with no install and no server.",
  "license": "MIT",
  "author": "vibingbiochemist <info@monoleaf.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibingbiochemist/Monoleaf_web.git"
  },
  "bugs": {
    "url": "https://github.com/vibingbiochemist/Monoleaf_web/issues"
  },
  "homepage": "https://monoleaf.org",
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "markdown-editor",
    "browser",
    "portable"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses": "node scripts/generate-licenses.mjs",
    "postinstall": "patch-package"
  },
  "overrides": {
    "katex": "$katex"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "pagedjs": "^0.4.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
